---
import Layout from "./Layout.astro";

const { frontmatter } = Astro.props;
const date = new Date(frontmatter.date).toLocaleDateString("fr-FR", { day: "numeric", month: "long", year: "numeric" });
---

<Layout title={`${frontmatter.title} · yunoo`} description={frontmatter.description} lang="fr" image={frontmatter.image}>
	<div class="container mx-auto max-w-3xl px-5 py-12">
		<header class="fade-up mb-10">
			<h1 class="text-3xl font-semibold text-foreground">{frontmatter.title}</h1>
			<p class="mt-3 text-sm text-muted-foreground">{date}</p>
		</header>
		<article class="article fade-up delay-100">
			<slot />
		</article>
	</div>
</Layout>

<style>
	/* ponytail: hand-rolled prose styles, add @tailwindcss/typography if articles grow */
	.article { line-height: 1.75; color: var(--muted-foreground); }
	.article :global(h2) { margin: 2.5rem 0 0.75rem; font-size: 1.35rem; font-weight: 600; color: var(--foreground); }
	.article :global(h3) { margin: 1.75rem 0 0.5rem; font-size: 1.05rem; font-weight: 600; color: var(--foreground); }
	.article :global(p), .article :global(ul), .article :global(ol), .article :global(pre), .article :global(blockquote), .article :global(table) { margin: 0 0 1rem; }
	.article :global(ul) { list-style: disc; padding-left: 1.25rem; }
	.article :global(ol) { list-style: decimal; padding-left: 1.25rem; }
	.article :global(li) { margin: 0.25rem 0; }
	.article :global(strong) { color: var(--foreground); font-weight: 600; }
	.article :global(a) { color: var(--primary); text-decoration: underline; text-underline-offset: 3px; }
	.article :global(:not(pre) > code) { font-family: var(--font-mono); font-size: 0.875em; padding: 0.1rem 0.35rem; border-radius: var(--radius-sm); background: var(--muted); color: var(--foreground); }
	.article :global(pre) { overflow-x: auto; padding: 1rem; border-radius: var(--radius-lg); font-size: 0.85rem; line-height: 1.6; }
	.article :global(pre code) { font-family: var(--font-mono); }
	.article :global(blockquote) { border-left: 3px solid var(--primary); padding-left: 1rem; }
	.article :global(table) { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
	.article :global(th), .article :global(td) { border-bottom: 1px solid var(--border); padding: 0.5rem 0.4rem; text-align: left; }
	.article :global(th) { color: var(--foreground); font-weight: 600; }
	/* inline SVG diagrams: theme colours, so they follow light / dark */
	.article :global(.dg) { display: block; width: 100%; height: auto; max-width: 560px; margin: 1.75rem auto; }
	.article :global(.dg.wide) { max-width: 680px; }
	.article :global(.dg .b) { fill: var(--card); stroke: var(--border); stroke-width: 1.5; }
	.article :global(.dg .bp) { fill: var(--primary); }
	.article :global(.dg .t) { fill: var(--foreground); font: 600 17px var(--font-sans); }
	.article :global(.dg .tp) { fill: var(--primary-foreground); font: 600 17px var(--font-sans); }
	.article :global(.dg .s) { fill: var(--muted-foreground); font: 400 14px var(--font-sans); }
	.article :global(.dg .sp) { fill: var(--primary); font: 600 14px var(--font-sans); }
	.article :global(.dg .l) { stroke: var(--muted-foreground); stroke-width: 1.75; fill: none; }
	.article :global(.dg .lp) { stroke: var(--primary); stroke-width: 2; fill: none; }
	.article :global(.dg .dash) { stroke-dasharray: 6 6; }
	.article :global(.dg .ah) { fill: var(--muted-foreground); }
	.article :global(.dg .ahp) { fill: var(--primary); }
</style>
