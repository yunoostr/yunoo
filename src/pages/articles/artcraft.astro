---
import Layout from "../../layouts/Layout.astro";

const title = "Les 13 applis open source d'ArtCraft";
const description = "Toutes les applis gratuites et open source d'ArtCraft (PhotoCraft, FilmCraft, EffectCraft…), avec le lien de chacune et le logiciel qu'elle remplace.";
const date = new Date("2026-10-13").toLocaleDateString("fr-FR", { day: "numeric", month: "long", year: "numeric" });
const base = "https://getartcraft.com/apps";

// Status and taglines from each app page on getartcraft.com (October 2026). "Alternative" is our comparison, not theirs.
const apps = [
	{ slug: "photocraft", name: "PhotoCraft", alt: "Photoshop", what: "Retouche d'image : calques, masques, filtres, et il ouvre tes PSD.", alpha: true },
	{ slug: "vectorcraft", name: "VectorCraft", alt: "Illustrator", what: "Illustration vectorielle." },
	{ slug: "filmcraft", name: "FilmCraft", alt: "Premiere Pro", what: "Montage vidéo : timeline, étalonnage, effets." },
	{ slug: "lightcraft", name: "LightCraft", alt: "Lightroom", what: "Bibliothèque photo et développement RAW." },
	{ slug: "pdfcraft", name: "PdfCraft", alt: "Acrobat", what: "Lire, annoter et modifier tes PDF.", alpha: true },
	{ slug: "effectcraft", name: "EffectCraft", alt: "After Effects", what: "Motion design et effets visuels." },
	{ slug: "designcraft", name: "DesignCraft", alt: "InDesign", what: "Mise en page et édition." },
	{ slug: "figcraft", name: "FigCraft", alt: "Figma", what: "Design d'interface.", alpha: true },
	{ slug: "wordcraft", name: "WordCraft", alt: "Word", what: "Traitement de texte." },
	{ slug: "soundcraft", name: "SoundCraft", alt: "Audition", what: "Enregistrement et mixage audio." },
	{ slug: "deckcraft", name: "DeckCraft", alt: "PowerPoint", what: "Présentations." },
	{ slug: "cadcraft", name: "CADCraft", alt: "AutoCAD", what: "Conception assistée par ordinateur (CAO)." },
	{ slug: "gridcraft", name: "GridCraft", alt: "Excel", what: "Tableur et analyse de données." },
];

const links = [
	{ label: "Tout télécharger (launcher)", href: "https://getartcraft.com/download", primary: true },
	{ label: "Le code sur GitHub", href: "https://github.com/storytold/artcraft" },
	{ label: "Le studio IA dans le navigateur", href: "https://app.getartcraft.com" },
];
---

<Layout title={`${title} · yunoo`} description={description} lang="fr" image="/artcraft/og.png">
	<div class="container mx-auto max-w-3xl px-5 py-12">
		<header class="fade-up mb-8">
			<img src="/artcraft/artcraft.svg" alt="" width="44" height="37" class="mb-5" />
			<h1 class="text-3xl font-semibold text-foreground">{title}</h1>
			<p class="mt-3 text-sm text-muted-foreground">{date}</p>
		</header>

		<p class="fade-up delay-100 mb-6 leading-relaxed text-muted-foreground">
			ArtCraft, c'est un projet open source qui sort une appli gratuite pour chaque logiciel créatif qu'on paye.
			Tout est codé en Rust, ça tourne sur ta carte graphique, sur Mac, Windows, Linux et même dans le navigateur.
			Voilà le lien de chaque appli.
		</p>

		<div class="fade-up delay-150 mb-8 flex flex-wrap gap-2">
			{links.map(({ label, href, primary }) => (
				<a href={href} target="_blank" rel="noopener"
					class={`rounded-lg px-4 py-2 text-sm font-medium transition-colors ${primary ? "bg-primary text-primary-foreground hover:bg-primary/90" : "border text-foreground/80 hover:bg-muted"}`}>
					{label}
				</a>
			))}
		</div>

		<ul class="grid gap-3 sm:grid-cols-2">
			{apps.map(({ slug, name, alt, what, alpha }, i) => (
				<li class="fade-up" style={`animation-delay: ${200 + i * 40}ms`}>
					<a href={`${base}/${slug}`} target="_blank" rel="noopener"
						class="flex h-full items-center gap-4 rounded-xl border p-3 transition-colors hover:bg-muted/60">
						<img src={`/artcraft/${slug}.webp`} alt={`Logo ${name}`} width="56" height="56" loading="lazy" class="size-14 shrink-0 rounded-xl" />
						<span class="flex min-w-0 flex-col gap-0.5">
							<span class="flex items-center gap-2">
								<span class="font-medium text-foreground">{name}</span>
								<span class={`rounded-full px-2 py-0.5 text-[11px] ${alpha ? "bg-primary/10 text-primary" : "bg-muted text-muted-foreground"}`}>
									{alpha ? "Alpha" : "En développement"}
								</span>
							</span>
							<span class="text-xs text-muted-foreground">À la place de {alt}</span>
							<span class="text-sm text-foreground/70">{what}</span>
						</span>
					</a>
				</li>
			))}
		</ul>

		<p class="fade-up mt-8 border-l-2 border-primary pl-4 text-sm leading-relaxed text-muted-foreground" style="animation-delay: 750ms">
			Petit spoil : c'est encore en alpha. Pour un projet client demain, garde tes logiciels habituels sous le coude.
			Mais vu la vitesse à laquelle ça avance, ça vaut le coup de tester.
		</p>
	</div>
</Layout>
